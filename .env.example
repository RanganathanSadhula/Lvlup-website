# Copy to .env.local and fill in. Nothing here is a real value.

# --- Public site configuration (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=https://example.com
# Digits only, with country code, e.g. 91XXXXXXXXXX.
NEXT_PUBLIC_WHATSAPP_NUMBER=919606626152
NEXT_PUBLIC_CONTACT_EMAIL=info@thinkova.ai
NEXT_PUBLIC_CONTACT_CITY=
# Where "Enrol" buttons go (your enrolment form / payment page). Empty = scrolls to "How joining works".
NEXT_PUBLIC_ENROL_URL=
# Where "Book a 20-minute call" goes (Calendly, Cal.com, etc.). Empty = scrolls to the school-pack form.
NEXT_PUBLIC_BOOKING_URL=

# --- SMTP Automation Mailer Configuration ---
# Hostname of your SMTP provider (e.g. smtp.zoho.com, smtp.gmail.com, email-smtp.us-east-1.amazonaws.com, smtp.sendgrid.net)
SMTP_HOST=smtp.zoho.com
# Port: 465 (SSL) or 587 (TLS/STARTTLS)
SMTP_PORT=587
# Set to true if using SSL on port 465, false for port 587
SMTP_SECURE=false
# SMTP Authentication Credentials
SMTP_USER=info@thinkova.ai
SMTP_PASSWORD=your_smtp_app_password_here
# Outgoing sender and reply-to headers
SMTP_FROM="ThinkOva <info@thinkova.ai>"
SMTP_REPLY_TO=info@thinkova.ai

# --- Cashfree Payment Gateway Configuration ---
# Environment: "SANDBOX" (or "TEST") for testing, "PRODUCTION" for live transactions
CASHFREE_ENV=SANDBOX
# Cashfree App ID / Client ID (from Cashfree Merchant Dashboard)
CASHFREE_APP_ID=
# Cashfree Secret Key
CASHFREE_SECRET_KEY=
# Cashfree PG API Version (default: 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# --- Database Connections (Dual-Database Architecture) ---
# 1. Schools & Institutional Management Database (Schools, Cohorts, Tutors, Capacity)
SCHOOLS_DATABASE_URL="postgresql://user:password@host:5432/schools_db?schema=public"

# 2. Students, Commerce & Messaging Database (Parents/Users, Students, Enrolments, Orders, Payments, Refunds)
STUDENTS_COMMERCE_DATABASE_URL="postgresql://user:password@host:5432/students_commerce_db?schema=public"

# --- Cron Engine & Security ---
# Bearer secret required for invoking /api/cron and /api/smtp triggers in production
CRON_SECRET=
ENABLE_INTERNAL_CRON=true

# --- Secondary / Legacy Providers (Optional fallback) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="ThinkOva Admissions <info@thinkova.ai>"

# Wati WhatsApp Gateway credentials
WATI_API_ENDPOINT=https://live-server-api.wati.io/api/v1
WATI_BEARER_TOKEN=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# The school-pack form POSTs validated JSON here (Zapier/Make/n8n/your CRM endpoint).
# Empty = the API responds 503 and the form shows an honest "not connected yet" error.
SCHOOL_PACK_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <value>" to the webhook.
SCHOOL_PACK_WEBHOOK_SECRET=

# Optional: URL of the "Watch a real class" video. Empty = the play button is shown as a non-interactive preview.
NEXT_PUBLIC_CLASS_VIDEO_URL=
